{
  "name": "krose-website",
  "version": "0.1.0",
  "private": true,
  "description": "KROSE preview",
  "engines": {
    "node": ">=22",
    "bun": ">=1.4.4"
  },
  "scripts": {
    "dev": "bun scripts/serve.cjs",
    "build": "bun scripts/vendor-opus.cjs && bun scripts/validate.cjs",
    "test": "bun scripts/test.cjs",
    "deploy": "wrangler deploy",
    "deploy:check": "wrangler deploy --dry-run",
    "deploy:pages": "wrangler pages deploy public --project-name=krose-website"
  },
  "packageManager": "bun@1.4.4",
  "devDependencies": {
    "ogg-opus-decoder": "1.7.5",
    "wrangler": "4.156.0"
  }
}
